---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="mx-auto max-w-[1100px] px-4 sm:px-6 pt-16 md:pt-24">
    <p class="label text-ink-2">Error 404</p>
    <h1 class="mt-3 text-[clamp(44px,7vw,84px)] leading-none font-[430]">Not in the programme.</h1>
    <p class="mt-6"><a class="link text-[18px] inline-flex min-h-11 items-center" href="/">Back to the workshop page →</a></p>
  </section>
</Base>
